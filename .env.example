# Redis
REDIS_URL=redis://redis:6379

# Groq
GROQ_API_KEY=your_groq_api_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# SEC EDGAR
SEC_USER_AGENT=YourName your@email.com
